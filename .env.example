# Configuración de DESARROLLO (docker-compose.dev.yml). Copiar a .env
APP_TZ=America/Bogota

DB_NAME=home_calendar
DB_USER=home
DB_PASSWORD=home_dev_pass
DB_ROOT_PASSWORD=root_dev_pass

JWT_SECRET=cambia-esto-en-dev-por-algo-largo

# Superusuario que se crea al arrancar (si no existe)
ADMIN_NAME=Admin
ADMIN_PASSWORD=admin12345

# Usuario especial para la pantalla ESP32
DISPLAY_NAME=Pantalla

# Permitir que cualquiera cree perfiles desde la pantalla de login
ALLOW_REGISTRATION=true
