# Configuración de PRODUCCIÓN (docker-compose.prod.yml).
# Recomendado: generar .env.prod con ./scripts/setup-env.sh (secretos aleatorios).
# Si lo haces a mano: copia a .env.prod, cambia TODOS los CAMBIAR y no uses los caracteres $ " '
APP_TZ=America/Bogota
HTTP_PORT=80

DB_NAME=home_calendar
DB_USER=home
DB_PASSWORD=CAMBIAR_password_largo_aleatorio
DB_ROOT_PASSWORD=CAMBIAR_root_password_largo_aleatorio

# Generar con: openssl rand -hex 48
JWT_SECRET=CAMBIAR

ADMIN_NAME=Admin
ADMIN_PASSWORD=CAMBIAR_min_8_caracteres

DISPLAY_NAME=Pantalla
ALLOW_REGISTRATION=true

# true solo si sirves la app por HTTPS (reverse proxy con TLS)
COOKIE_SECURE=false
# 1 = acceso directo; 2 si hay un reverse proxy (Nginx Proxy Manager, Caddy…) delante
TRUST_PROXY=1
